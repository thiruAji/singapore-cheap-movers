# =========================================================================
# 1. GOOGLE GEMINI AI KEY (Shared by Website Chat & WhatsApp Bot)
# Get a free key at: https://aistudio.google.com/apikey
# =========================================================================
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# =========================================================================
# 2. ADMIN / STAFF WHATSAPP NUMBER (Receives instant lead alerts)
# Country code + number, no '+' or spaces (e.g. 6591234567)
# =========================================================================
WA_ADMIN_PHONE=6584076882

# =========================================================================
# 3A. LOCAL WHATSAPP BOT CONNECTION (whatsapp-web.js / Baileys / WAHA)
# Point WA_LOCAL_SEND_URL to your local WhatsApp bot's HTTP send endpoint
# =========================================================================
WA_LOCAL_SEND_URL=http://localhost:3001/send
WA_LOCAL_API_KEY=

# =========================================================================
# 3B. OR OFFICIAL META WHATSAPP CLOUD API (Optional alternative)
# =========================================================================
WA_VERIFY_TOKEN=scm_verify_token
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=

# Server port (default 3000)
# PORT=3000
